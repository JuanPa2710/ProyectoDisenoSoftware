@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHomeController = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIVCR</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SIVCR.Web.styles.css" asp-append-version="true" />
</head>
<body class="sivcr-shell">
    <header class="sivcr-topbar">
        <a class="sivcr-brand" asp-controller="Home" asp-action="Index" aria-label="Ir al dashboard de SIVCR">
            <span class="sivcr-brand__mark" aria-hidden="true">
                <svg viewBox="0 0 18 18" focusable="false">
                    <path d="M5.2 2.25 2.8 15.75M12.8 2.25l2.4 13.5M8.1 2.25 6.9 15.75M9.9 2.25l1.2 13.5" />
                    <path d="M8.95 4.2h.1M8.95 7.1h.1M8.95 10h.1M8.95 12.9h.1" />
                </svg>
            </span>
            <span class="sivcr-brand__name">SIVCR</span>
            <span class="sivcr-brand__separator" aria-hidden="true"></span>
            <span class="sivcr-brand__description">Sistema de Información y Predictibilidad Vial de Costa Rica</span>
        </a>

        <div class="sivcr-userbar">
            <button class="sivcr-icon-button" type="button" aria-label="Notificaciones">
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="M4.5 8.7a5.5 5.5 0 0 1 11 0c0 5 2 5.3 2 6.3h-15c0-1 2-1.3 2-6.3Z" />
                    <path d="M8 17h4" />
                </svg>
            </button>
            <span class="sivcr-avatar" aria-hidden="true">AT</span>
            <span class="sivcr-userbar__name">Analista de Tránsito</span>
        </div>
    </header>

    <div class="sivcr-body">
        <aside class="sivcr-sidebar" aria-label="Navegación principal">
            <div class="sivcr-sidebar__section-title">Análisis</div>

            <a class="sivcr-nav-item @(isHomeController && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase) ? "sivcr-nav-item--active" : "")" asp-controller="Home" asp-action="Index">
                <svg class="sivcr-nav-item__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <rect x="2.5" y="2.5" width="5" height="5" rx=".5" />
                    <rect x="12.5" y="2.5" width="5" height="5" rx=".5" />
                    <rect x="2.5" y="12.5" width="5" height="5" rx=".5" />
                    <rect x="12.5" y="12.5" width="5" height="5" rx=".5" />
                </svg>
                <span>Dashboard</span>
            </a>
            <a class="sivcr-nav-item" href="#" aria-disabled="true">
                <svg class="sivcr-nav-item__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <rect x="2.5" y="3" width="15" height="14" rx="1" />
                    <path d="M2.5 7h15M7 7v10" />
                </svg>
                <span>Explorador de registros</span>
            </a>
            <a class="sivcr-nav-item @(isHomeController && string.Equals(currentAction, "FiltrosGuardados", StringComparison.OrdinalIgnoreCase) ? "sivcr-nav-item--active" : "")" asp-controller="Home" asp-action="FiltrosGuardados">
                <svg class="sivcr-nav-item__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="M5 3h10v14l-5-3-5 3V3Z" />
                </svg>
                <span>Filtros guardados</span>
            </a>
            <a class="sivcr-nav-item" href="#" aria-disabled="true">
                <svg class="sivcr-nav-item__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="M2.5 13a7.5 7.5 0 0 1 15 0" />
                    <path d="m10 10 3-3" />
                </svg>
                <span>Predicción de riesgo</span>
            </a>

            <div class="sivcr-sidebar__section-title sivcr-sidebar__section-title--spaced">Administración</div>

            <a class="sivcr-nav-item" href="#" aria-disabled="true">
                <svg class="sivcr-nav-item__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="M10 13V3M6.5 6.5 10 3l3.5 3.5M3 11.5V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4.5" />
                </svg>
                <span>Carga de datos</span>
            </a>
        </aside>

        <main class="sivcr-main" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
